    "configuration": {
      "title": "Git Kitchen",
      "properties": {
        "gitKitchen.blame.currentLine": {
          "type": "boolean",
          "default": true,
          "description": "Show blame at the end of the current line."
        },
        "gitKitchen.blame.highlightLine": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the whole current line while line blame is shown."
        },
        "gitKitchen.blame.highlightSameCommit": {
          "type": "boolean",
          "default": true,
          "description": "Highlight other lines from the same commit as the current or hovered line."
        },
        "gitKitchen.blame.changesHover": {
          "type": "boolean",
          "default": true,
          "description": "Show the line's diff hunk from its commit in the blame hover."
        },
        "gitKitchen.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the current line's author and time in the status bar. Click to open the commit changes."
        },
        "gitKitchen.changes.gutter": {
          "type": "boolean",
          "default": true,
          "description": "Mark added, changed and deleted lines against HEAD in the gutter."
        },
        "gitKitchen.branches.colorActiveLabel": {
          "type": "boolean",
          "default": false,
          "description": "Also color the current branch's label, not only its icon."
        },
        "gitKitchen.staleness.agingDays": {
          "type": "number",
          "default": 14,
          "minimum": 0,
          "description": "A branch whose last commit is at least this many days old is shown as aging."
        },
        "gitKitchen.staleness.staleDays": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "A branch whose last commit is more than this many days old is shown as stale."
        },
        "gitKitchen.staleness.behindCount": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "A branch more than this many commits behind its upstream (or the main branch when it has none) is shown as stale. Any commits behind marks it as aging."
        },
        "gitKitchen.files.layout": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "default": "tree",
          "description": "Show a commit's changed files as a folder tree (compacting single-folder chains) or as a flat list."
        },
        "gitKitchen.branches.layout": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "default": "tree",
          "description": "Show branches grouped into folders by their / prefix, or as a flat list."
        },
        "gitKitchen.heatmap.location": {
          "type": "string",
          "enum": [
            "gutter",
            "background"
          ],
          "default": "gutter",
          "description": "Where the file heatmap is drawn."
        },
        "gitKitchen.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the last author and author count above the file and its functions and classes."
        },
        "gitKitchen.codeLens.symbols": {
          "type": "boolean",
          "default": true,
          "description": "Also show the code lens above functions and classes, not only at the top of the file."
        },
        "gitKitchen.blame.hover": {
          "type": "boolean",
          "default": true,
          "description": "Show commit details on hover."
        },
        "gitKitchen.mainBranch": {
          "type": "string",
          "default": "main",
          "description": "Main branch used for merged cleanup, PR base and Compare Remotes."
        },
        "gitKitchen.dualRemote.source": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Compare Remotes: the remote whose commits are listed. Saved per folder when you choose or swap. When empty with two remotes, origin is used, otherwise the current branch's upstream remote, otherwise the first alphabetically."
        },
        "gitKitchen.dualRemote.target": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Compare Remotes: the remote checked for those commits. Saved per folder when you choose or swap."
        }
      }
    }
