      },
      {
        "command": "gitKitchen.compareCommitWorking",
        "title": "Compare with Working Copy",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.history.compareWorking",
        "title": "Compare with Working Copy",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.commit.openAllFiles",
        "title": "Open All Changed Files",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.commit.copyLink",
        "title": "Copy Link",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.commit.copySha",
        "title": "Copy SHA",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.commit.openOnGitHub",
        "title": "Open on GitHub",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.blame.toggleFile",
        "title": "Toggle File Blame",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.blame.toggleLine",
