{
  "name": "gitkitchen",
  "displayName": "Git Kitchen",
  "description": "Branches, remotes, stashes, worktrees, pull requests, blame and history for the editor.",
  "version": "0.3.0",
  "publisher": "heroeskitchen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Heroeskitchen/gitkitchen"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "test": "vitest run",
    "smoke": "npm run compile && node ./out/smoke/run.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "gitKitchen.refresh",
        "title": "Refresh",
        "category": "Git Kitchen",
        "icon": "$(refresh)"
      },
