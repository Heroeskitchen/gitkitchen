      },
      {
        "command": "gitKitchen.annotations.changes",
        "title": "Toggle File Changes…",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.annotations.settings",
        "title": "Open Annotation Settings",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.lens.blame",
        "title": "Show File Blame",
