        "title": "Compare Changes",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.pr.merge",
        "title": "Merge…",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.pr.squash",
        "title": "Squash and Merge…",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.pr.rebase",
