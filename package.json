      },
      {
        "command": "gitKitchen.dual.chooseRemote",
        "title": "Choose Remotes to Compare…",
        "category": "Git Kitchen",
        "icon": "$(filter)"
      },
      {
        "command": "gitKitchen.dual.swap",
        "title": "Swap Compare Direction",
        "category": "Git Kitchen",
        "icon": "$(arrow-both)"
      },
      {
        "command": "gitKitchen.dual.fetch",
        "title": "Fetch All Remotes",
        "category": "Git Kitchen",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "gitKitchen.merged.delete",
        "title": "Delete Branch…",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.merged.reviewAll",
        "title": "Review Merged Branches One by One…",
        "category": "Git Kitchen",
        "icon": "$(checklist)"
      },
      {
        "command": "gitKitchen.operation.continue",
        "title": "Continue",
        "category": "Git Kitchen",
        "icon": "$(debug-continue)"
      },
      {
        "command": "gitKitchen.operation.skip",
        "title": "Skip Commit",
        "category": "Git Kitchen",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "gitKitchen.operation.abort",
        "title": "Abort…",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.explorer.reopenHere",
        "title": "Reopen Here",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.explorer.openNewWindow",
        "title": "Open in New Window",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.explorer.setDefaultWorkspace",
        "title": "Set as Default Workspace for This Folder",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.explorer.clearDefaultWorkspace",
        "title": "Clear Default Workspace",
        "category": "Git Kitchen"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitKitchen.refresh",
          "when": "view == gitKitchen.commits",
          "group": "navigation@9"
        },
        {
          "command": "gitKitchen.refresh",
          "when": "view == gitKitchen.todos",
          "group": "navigation@9"
        },
        {
          "command": "gitKitchen.refresh",
          "when": "view == gitKitchen.history",
          "group": "navigation@9"
        },
        {
          "command": "gitKitchen.refresh",
          "when": "view == gitKitchen.branches",
          "group": "9_refresh@1"
        },
        {
          "command": "gitKitchen.refresh",
          "when": "view == gitKitchen.remotes",
          "group": "9_refresh@1"
        },
        {
          "command": "gitKitchen.refresh",
          "when": "view == gitKitchen.stashes",
          "group": "9_refresh@1"
        },
        {
          "command": "gitKitchen.refresh",
          "when": "view == gitKitchen.worktrees",
          "group": "9_refresh@1"
        },
        {
          "command": "gitKitchen.refresh",
          "when": "view == gitKitchen.prs",
          "group": "9_refresh@1"
        },
        {
          "command": "gitKitchen.refresh",
          "when": "view == gitKitchen.dual",
          "group": "9_refresh@1"
        },
        {
          "command": "gitKitchen.refresh",
          "when": "view == gitKitchen.merged",
          "group": "9_refresh@1"
        },
        {
          "command": "gitKitchen.branch.create",
          "when": "view == gitKitchen.branches",
          "group": "navigation@1"
        },
        {
          "command": "gitKitchen.worktree.createNewBranch",
          "when": "view == gitKitchen.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "gitKitchen.worktree.prune",
          "when": "view == gitKitchen.worktrees",
          "group": "8_housekeeping@1"
        },
        {
          "command": "gitKitchen.pr.create",
          "when": "view == gitKitchen.prs",
          "group": "navigation@1"
        },
        {
          "command": "gitKitchen.stash.save",
          "when": "view == gitKitchen.stashes",
          "group": "navigation@1"
        },
        {
          "command": "gitKitchen.stash.stashAndSwitch",
          "when": "view == gitKitchen.stashes",
          "group": "1_stash@1"
        },
        {
          "command": "gitKitchen.dual.chooseRemote",
          "when": "view == gitKitchen.dual",
          "group": "navigation@1"
        },
        {
          "command": "gitKitchen.dual.swap",
          "when": "view == gitKitchen.dual",
          "group": "navigation@2"
        },
        {
          "command": "gitKitchen.dual.fetch",
          "when": "view == gitKitchen.dual",
          "group": "navigation@3"
        },
        {
          "command": "gitKitchen.merged.reviewAll",
          "when": "view == gitKitchen.merged",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gitKitchen.branch.switch",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /^branch(?!\\.current)/",
          "group": "1_a@1"
        },
        {
          "command": "gitKitchen.branch.create",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/",
          "group": "1_a@2"
        },
        {
          "command": "gitKitchen.branch.rename",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/",
          "group": "1_a@3"
        },
        {
          "command": "gitKitchen.branch.delete",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /^branch(?!\\.current)/",
          "group": "9_danger@1"
        },
        {
          "command": "gitKitchen.branch.merge",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /^branch(?!\\.current)/",
          "group": "2_b@1"
        },
        {
          "command": "gitKitchen.branch.rebase",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /^branch(?!\\.current)/",
          "group": "2_b@2"
        },
        {
          "command": "gitKitchen.branch.reset",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /^branch(?!\\.current)/",
          "group": "2_b@3"
        },
        {
          "command": "gitKitchen.branch.pull",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /tracked/",
          "group": "3_c@1"
        },
        {
          "command": "gitKitchen.branch.fetch",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/",
          "group": "3_c@2"
        },
        {
          "command": "gitKitchen.branch.setUpstream",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/",
          "group": "3_c@3"
        },
        {
          "command": "gitKitchen.branch.createTag",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/",
          "group": "4_d@1"
        },
        {
          "command": "gitKitchen.branch.openOnRemote",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/",
          "group": "4_d@2"
        },
        {
          "command": "gitKitchen.branch.copyName",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/",
          "group": "4_d@3"
        },
        {
          "command": "gitKitchen.branch.compareUpstream",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /tracked/",
          "group": "5_e@1"
        },
        {
          "command": "gitKitchen.branch.compareHead",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /^branch(?!\\.current)/",
          "group": "5_e@2"
        },
        {
          "command": "gitKitchen.branch.compareBase",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /^branch(?!\\.current)/",
          "group": "5_e@3"
        },
        {
          "command": "gitKitchen.branch.compareWorking",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/",
          "group": "5_e@4"
        },
        {
          "command": "gitKitchen.branch.selectForCompare",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/",
          "group": "5_e@5"
        },
        {
          "command": "gitKitchen.branch.compareSelected",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && gitKitchen.hasCompareSelection",
          "group": "5_e@6"
        },
        {
          "command": "gitKitchen.branch.push",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch\\.current/",
          "group": "3_c@0"
        },
        {
          "command": "gitKitchen.branch.pull",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch\\.current/ && viewItem =~ /tracked/",
          "group": "inline@1"
        },
        {
          "command": "gitKitchen.branch.push",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch\\.current/",
          "group": "inline@2"
        },
        {
          "command": "gitKitchen.branch.switch",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /^branch(?!\\.current)/",
          "group": "inline@1"
        },
        {
          "command": "gitKitchen.branch.compareHead",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /^branch(?!\\.current)/",
          "group": "inline@2"
        },
        {
          "command": "gitKitchen.worktree.create",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /noWorktree/ && viewItem =~ /^branch(?!\\.current)/",
          "group": "6_wt@1"
        },
        {
          "command": "gitKitchen.worktree.createNewBranch",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/",
          "group": "6_wt@2"
        },
        {
          "command": "gitKitchen.worktree.openNewWindow",
          "when": "(view == gitKitchen.worktrees && viewItem =~ /^worktree/) || (view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /\\.worktree/)",
          "group": "6_wt@3"
        },
        {
          "command": "gitKitchen.worktree.openHere",
          "when": "(view == gitKitchen.worktrees && viewItem =~ /^worktree/) || (view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /\\.worktree/)",
          "group": "6_wt@4"
        },
        {
          "command": "gitKitchen.worktree.reveal",
          "when": "(view == gitKitchen.worktrees && viewItem =~ /^worktree/) || (view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /\\.worktree/)",
          "group": "6_wt@5"
        },
        {
          "command": "gitKitchen.worktree.terminal",
          "when": "(view == gitKitchen.worktrees && viewItem =~ /^worktree/) || (view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /\\.worktree/)",
          "group": "6_wt@6"
        },
        {
          "command": "gitKitchen.worktree.lock",
          "when": "view == gitKitchen.worktrees && viewItem =~ /^worktree(?!\\.main)/ && viewItem != worktree.locked",
          "group": "7_wt@1"
        },
        {
          "command": "gitKitchen.worktree.unlock",
          "when": "view == gitKitchen.worktrees && viewItem == worktree.locked",
          "group": "7_wt@2"
        },
        {
          "command": "gitKitchen.worktree.move",
          "when": "view == gitKitchen.worktrees && viewItem =~ /^worktree(?!\\.main)/",
          "group": "7_wt@3"
        },
        {
          "command": "gitKitchen.worktree.remove",
          "when": "view == gitKitchen.worktrees && viewItem =~ /^worktree(?!\\.main)/ || (view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /\\.worktree/)",
          "group": "9_danger@1"
        },
        {
          "command": "gitKitchen.worktree.openNewWindow",
          "when": "view == gitKitchen.worktrees && viewItem =~ /^worktree/",
          "group": "inline@1"
        },
        {
          "command": "gitKitchen.pr.create",
          "when": "view == gitKitchen.branches && viewItem =~ /^branch/ && viewItem =~ /^branch(?!.*hasPr)/",
          "group": "8_pr@1"
        },
        {
          "command": "gitKitchen.pr.open",
