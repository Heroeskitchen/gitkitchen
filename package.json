      },
      {
        "command": "gitKitchen.fileHistory",
        "title": "File History",
        "category": "Git Kitchen",
        "icon": "$(history)"
      },
      {
        "command": "gitKitchen.commits.loadMore",
        "title": "Load More Commits",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.diffFile",
        "title": "Open Changes",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.rev.prev",
        "title": "Open Previous Revision",
        "category": "Git Kitchen",
        "icon": "$(chevron-left)"
      },
      {
        "command": "gitKitchen.rev.next",
        "title": "Open Next Revision",
        "category": "Git Kitchen",
        "icon": "$(chevron-right)"
      },
      {
        "command": "gitKitchen.rev.choose",
        "title": "Choose Revision…",
        "category": "Git Kitchen"
      },
      {
        "command": "gitKitchen.annotations.heatmap",
