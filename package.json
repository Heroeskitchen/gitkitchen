      {
        "id": "gitKitchen.currentLineBackground",
        "description": "Background of the current line while line blame is shown.",
        "defaults": {
          "dark": "#ffffff0b",
          "light": "#0000000a",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "gitKitchen.activeBranchForeground",
        "description": "Icon of the current branch.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "testing.iconPassed",
          "highContrastLight": "testing.iconPassed"
        }
      },
      {
        "id": "gitKitchen.branchFreshForeground",
        "description": "Icon of a branch that is up to date and recently committed to.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green",
          "highContrastLight": "charts.green"
        }
      },
      {
        "id": "gitKitchen.branchAgingForeground",
        "description": "Icon of a branch that is a little behind or has not been committed to for a while.",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow",
          "highContrastLight": "charts.yellow"
        }
      },
      {
        "id": "gitKitchen.branchStaleForeground",
        "description": "Icon of a branch that is far behind or has not been committed to for a long time.",
        "defaults": {
          "dark": "gitDecoration.ignoredResourceForeground",
          "light": "gitDecoration.ignoredResourceForeground",
          "highContrast": "descriptionForeground",
          "highContrastLight": "descriptionForeground"
        }
      },
      {
        "id": "gitKitchen.branchGoneForeground",
        "description": "Icon of a branch whose upstream was deleted.",
        "defaults": {
          "dark": "gitDecoration.deletedResourceForeground",
          "light": "gitDecoration.deletedResourceForeground",
          "highContrast": "gitDecoration.deletedResourceForeground",
          "highContrastLight": "gitDecoration.deletedResourceForeground"
        }
      },
      {
        "id": "gitKitchen.prOpenForeground",
        "description": "Icon of an open pull request.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green",
          "highContrastLight": "charts.green"
        }
      },
      {
        "id": "gitKitchen.sameCommitBackground",
